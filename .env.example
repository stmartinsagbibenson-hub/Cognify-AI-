# Cognify runtime. Set NODE_ENV=production and HOST=0.0.0.0 on a public host.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Set true only when a trusted reverse proxy overwrites X-Forwarded-* headers.
TRUST_PROXY=false
# Must be true on a public HTTPS deployment.
COOKIE_SECURE=false

# Public origin used for Google callback and payment return URLs.
# Required in production; use the exact HTTPS origin with no path or trailing route.
APP_URL=http://localhost:3000
# Deprecated compatibility alias; use APP_URL instead.
PUBLIC_APP_URL=
# SQLite database file. Point this to the host's persistent volume in production.
DATABASE_PATH=./data/cognify.sqlite

# Google OAuth 2.0 Web client. Required for Google sign-in in production.
# Google Console values derive from APP_URL:
#   Origin: APP_URL
#   Callback: APP_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deprecated; Cognify derives the callback URL from APP_URL. Leave blank.
GOOGLE_REDIRECT_URI=

# Groq powers AI tutoring and generated practice. Required for AI features in production.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Email verification and password reset. Required in production.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Replace example.com with a sender on the domain verified in Resend.
EMAIL_FROM=Cognify <hello@example.com>

# Payments are optional until billing is enabled. Use ONLY test keys outside production.
PAYMENT_PROVIDER=paystack
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=
# Optional; leave blank to let Cognify create a monthly NGN plan.
PAYSTACK_PLAN_CODE=

# Initial defaults. Admin settings persist in SQLite after first startup.
FREE_USAGE_LIMIT=15
PREMIUM_PRICE_NGN=3200

# Admin control room access. Both are required in production.
ADMIN_EMAIL=
# Generate with: openssl rand -hex 32
ADMIN_ACCESS_KEY=

# Test-only switch. Keep unset/false in production; required to send a test email there.
ALLOW_PRODUCTION_TEST_EMAIL=false
# Smoke-test only. Prevents test databases from importing local data/accounts.json.
SKIP_LEGACY_ACCOUNT_IMPORT=false
# Internal smoke-test capture file; npm run smoke sets this in its child process.
SMOKE_CAPTURE_PATH=
